generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model SiteSettings {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  country        String   @unique
  seo            Json
  tracking       Json
  site           Json
  images         Json
  pricingTeaser  Json
  updatedAt      DateTime @default(now())
}

model Subscriber {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  email        String   @unique
  phone        String
  businessName String?
  businessType String?
  planName     String
  planIndex    Int?
  country      String
  isAnnual     Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([country])
  @@index([createdAt])
}
