generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model SiteSettings {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  gtmId           String   @default("")
  whatsappNumber  String   @default("")
  updatedAt       DateTime @default(now())
}

// ─────────────────────────────────────────────────────────────────
// Subscriber — represents ANY attempt to check out (paid, failed, pending, abandoned).
// Stage 3 additions: paymentStatus lifecycle + compound unique (email, plan, billing)
// so a single user can have multiple attempts across plans/cycles without collision.
// Old fields (planName · planIndex · isAnnual) kept for backward compat with existing
// 15 rows; deprecated in favor of new (plan · billing) canonical slug pair.
// ─────────────────────────────────────────────────────────────────

enum PaymentStatus {
  pending
  paid
  failed
  abandoned
  refunded
}

model Subscriber {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  contactName  String?
  email        String
  phone        String
  businessName String?
  businessType String?

  // Deprecated (Stage-1 lead-capture era) — kept for backward compat only
  planName     String
  planIndex    Int?
  isAnnual     Boolean  @default(false)

  // Canonical Stage-3 checkout fields
  plan          String        @default("")            // slug: starter | growth | scale
  billing       String        @default("")            // "monthly" | "annual"
  paymentStatus PaymentStatus @default(pending)
  paymentRef    String?                               // N-Genius transaction reference
  paidAt        DateTime?
  failReason    String?

  country      String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  @@unique([email, plan, billing])                     // Idempotency layer 1 (Decision #2)
  @@index([country])
  @@index([createdAt])
  @@index([paymentStatus])
  @@index([email])
}

// ─────────────────────────────────────────────────────────────────
// WebhookEvent — Idempotency layer 3 (Decision #2).
// Deduplicates N-Genius webhook deliveries. If we ever see the same
// providerEventId twice, we skip processing.
// ─────────────────────────────────────────────────────────────────

model WebhookEvent {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  provider        String                          // "n-genius"
  providerEventId String    @unique               // dedup key
  eventType       String                          // "captured" | "failed" | "refunded"
  payload         Json                            // raw webhook body
  signature       String                          // for later verification/audit
  processed       Boolean   @default(false)
  receivedAt      DateTime  @default(now())
  processedAt     DateTime?

  @@index([provider, eventType])
  @@index([processed])
}

model LandingSection {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  section   String   @unique
  data      Json
  updatedAt DateTime @updatedAt
}

model ExitReason {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  reason    String
  country   String
  createdAt DateTime @default(now())

  @@index([country])
  @@index([reason])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────────
// Pricing — split per-plan rows + section-level meta. Replaces the
// old `LandingSection { section: "pricing" }` JSON blob. See
// docs/PRICING-REFACTOR-PLAN.md.
// ─────────────────────────────────────────────────────────────────

model Plan {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId

  // Control
  country         String                                  // "SA" | "EG"
  slug            String                                  // "free" | "starter" | "growth" | "scale"
  visible         Boolean  @default(true)
  displayOrder    Int

  // Core content
  name            String
  tagline         String   @default("")
  priceMonthly    Int      @default(0)
  priceYearly     Int      @default(0)
  articlesLabel   String   @default("")
  ctaText         String   @default("")
  hook            String?                                 // Single distinctive line surfaced near price (the "catching" feature)
  highlights      String[]

  // Badges
  badge           String?
  featuredBadge   String?

  updatedAt       DateTime @updatedAt

  @@unique([country, slug])
  @@index([country, displayOrder])
}

model PriceSectionMeta {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  country         String   @unique

  announcement    String   @default("")

  ctaHeadline     String   @default("")
  ctaSubheadline  String   @default("")

  trustItems      Json     @default("[]")
  uiStrings       Json     @default("{}")

  updatedAt       DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────────
// READ-ONLY MIRROR of Modonty's Client + Media collections.
// jbrseo shares the same MongoDB cluster/database as Modonty. This
// file declares a MINIMAL subset of the shape so we can query real
// paying-client logos for the "من ائتمنّا" trust section.
//
// RULES:
//   1. NEVER write to these tables from jbrseo. All queries here are
//      read-only (`findMany` + `select`). Any mutation belongs in
//      the Modonty app.
//   2. When Modonty changes the field names below, this schema must
//      be updated in lockstep — otherwise queries silently return
//      wrong data. See MODONTY/dataLayer/prisma/schema/schema.prisma.
//   3. The `@@map` is required — Prisma otherwise looks for
//      `Client`/`Media` collections which don't exist (Modonty maps
//      them to lowercase `clients`/`media`).
// ─────────────────────────────────────────────────────────────────

enum ModontySubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  PENDING
}

enum ModontyPaymentStatus {
  PAID
  PENDING
  OVERDUE
}

model ModontyClient {
  id                 String                   @id @default(auto()) @map("_id") @db.ObjectId
  name               String
  slug               String                   @unique
  url                String?
  logoMediaId        String?                  @db.ObjectId
  logoMedia          ModontyMedia?            @relation("ModontyClientLogo", fields: [logoMediaId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  industryId         String?                  @db.ObjectId
  industry           ModontyIndustry?         @relation("ModontyClientIndustry", fields: [industryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  subscriptionStatus ModontySubscriptionStatus @default(PENDING)
  paymentStatus      ModontyPaymentStatus     @default(PENDING)
  isFeatured         Boolean                  @default(false)

  @@map("clients")
}

model ModontyMedia {
  id      String          @id @default(auto()) @map("_id") @db.ObjectId
  url     String
  altText String?
  clients ModontyClient[] @relation("ModontyClientLogo")

  @@map("media")
}

model ModontyIndustry {
  id      String          @id @default(auto()) @map("_id") @db.ObjectId
  name    String
  slug    String          @unique
  clients ModontyClient[] @relation("ModontyClientIndustry")

  @@map("industries")
}
